# env.sh - copy to common/env.sh and adjust; every chapter's run.sh sources it.
#   cp common/env.sh.example common/env.sh
# The defaults match common/build_dpdk.sh.

export DPDK_SRC=${DPDK_SRC:-$HOME/dpdk}                 # DPDK source tree (docs, examples, build/)
export DPDK_PREFIX=${DPDK_PREFIX:-$HOME/dpdk-install}   # meson install prefix

# libdpdk.pc lives in lib/<multiarch>/pkgconfig on Debian/Ubuntu, lib64/pkgconfig on Fedora
for d in "$DPDK_PREFIX"/lib/*/pkgconfig "$DPDK_PREFIX"/lib64/pkgconfig "$DPDK_PREFIX"/lib/pkgconfig; do
	if [ -f "$d/libdpdk.pc" ]; then
		export PKG_CONFIG_PATH="$d${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
		break
	fi
done
export PATH="$DPDK_PREFIX/bin:$PATH"

# Prebuilt sample applications are not on PATH: $E/dpdk-helloworld, $E/dpdk-l2fwd, ...
export E="$DPDK_SRC/build/examples"

pkg-config --exists libdpdk || echo "env.sh: libdpdk not found; check DPDK_PREFIX" >&2
